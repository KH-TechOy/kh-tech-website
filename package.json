{
  "name": "kh-tech-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-brand-assets.mjs && tsc -b && vite build && node scripts/build-offline-shell.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "game:art": "node scripts/build-game-art.mjs",
    "test:game": "playwright test",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "test:website": "playwright test --config playwright.website.config.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.6.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  }
}
