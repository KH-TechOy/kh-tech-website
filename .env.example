# Use / for a custom domain or /REPOSITORY/ for a GitHub Pages project site.
VITE_BASE_PATH=/
# Public configuration only. Leave blank until manual real-delivery acceptance and privacy approval.
# API URL is the deployed Cloudflare Worker endpoint, never the Apps Script URL.
VITE_CONTACT_API_URL=
VITE_TURNSTILE_SITE_KEY=
# Public Firebase web-app settings only; never put a service-account key in VITE_*.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_REPORT_API_URL=
